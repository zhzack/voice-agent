# =====================================================================
# 方案一：Qwen3.8-27B (Q3_K_M) - 100% 纯 GPU 显存全速模式
# 硬件适配：AMD Radeon RX 9070 XT (16GB VRAM)
# 显存占用：约 12.2 GB - 14.0 GB (含 8K 上下文 KV Cache)
# 运行表现：首字延迟极低，纯 GPU 推理，速度最快 (25~35 token/s)
# =====================================================================
FROM ./models/qwen3.8-27b-instruct-q3_k_m.gguf

# 上下文长度设为 8192 (保留充足显存给系统桌面与渲染)
PARAMETER num_ctx 8192

# 核心参数：全部层卸载至 GPU 显存
PARAMETER num_gpu 99

# 生成超参数
PARAMETER temperature 0.7
PARAMETER top_p 0.9
PARAMETER repeat_penalty 1.1

# 系统提示词
SYSTEM "你是由阿里云通义千问团队打造的 Qwen3.8-27B 超大语言模型。你擅长复杂逻辑思考、深度编程与自然口语对话。回答简明扼要，重点突出。"

