# =====================================================================
# 方案二：Qwen3.8-27B (Q4_K_M) - 显存 80% + 内存 20% 混合分层模式
# 硬件适配：AMD Radeon RX 9070 XT (16GB) + Ryzen 7 9800X3D + 32GB RAM
# 显存占用：受控在约 13.5 GB 以内，余量由 32GB 内存承担
# 运行表现：智商与代码能力接近无损，速度极佳 (15~25 token/s)
# =====================================================================
FROM ./models/qwen3.8-27b-instruct-q4_k_m.gguf

# 混合模式支持更大上下文
PARAMETER num_ctx 16384

# 核心参数：前 52 层卸载至 GPU 显存，剩余 12 层由 CPU 内存分担
PARAMETER num_gpu 52

# 生成超参数
PARAMETER temperature 0.7
PARAMETER top_p 0.9
PARAMETER repeat_penalty 1.1

# 系统提示词
SYSTEM "你是由阿里云通义千问团队打造的 Qwen3.8-27B 超大语言模型。你擅长复杂逻辑思考、深度编程与自然口语对话。回答简明扼要，重点突出。"

